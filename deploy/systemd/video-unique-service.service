[Unit]
Description=Video Unique Service Telegram bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=vuniq
Group=vuniq
WorkingDirectory=/var/lib/video-unique-service
StateDirectory=video-unique-service
StateDirectoryMode=0700
UMask=0077
Environment=SERVER_ADDRESS=127.0.0.1
Environment=FFMPEG_PATH=/usr/bin/ffmpeg
Environment=FFPROBE_PATH=/usr/bin/ffprobe
ExecStartPre=/usr/bin/mkdir -p /var/lib/video-unique-service/tmp /var/lib/video-unique-service/state
ExecStart=/opt/video-unique-service/java/bin/java -Xmx768m -Djava.awt.headless=true -Djava.io.tmpdir=/var/lib/video-unique-service/tmp -jar /opt/video-unique-service/video-unique-service.jar --spring.config.additional-location=file:/etc/video-unique-service/telegram.properties --telegram.offset-file=/var/lib/video-unique-service/state/telegram-offset.txt
MemoryHigh=2500M
MemoryMax=3G
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
